# Local web server port.
PORT=8787

# iFinD HTTP API credentials. Keep real values in local .env only.
# THS_ACCESS_TOKEN may be omitted when THS_REFRESH_TOKEN is available.
THS_APP_KEY=your_key_here
THS_APP_SECRET=your_secret_here
THS_ACCESS_TOKEN=your_token_here
THS_REFRESH_TOKEN=your_refresh_token_here
